# Environment read by syncai_tts. main.py calls dotenv.load_dotenv() BEFORE
# Settings.from_env(), and every value below is read inside that call rather
# than at module import — so a variable that exists only in .env is actually
# seen. (syncai_backend's temporal/shared.py reads TEMPORAL_ADDRESS at import
# time, before its own load_dotenv(), and silently never sees the .env value;
# this file is laid out to not repeat that.)

# ── HTTP ─────────────────────────────────────────────────────────────────────
TTS_HOST=0.0.0.0
TTS_PORT=8080

# Comma-separated browser origins allowed to call this service. Empty (the
# default) installs no CORS middleware at all, which is correct here: the
# callers are syncai_backend and the Temporal worker, both server-side, and
# neither is subject to CORS. Set it only if a browser ever talks to this
# service directly.
# TTS_CORS_ORIGINS=

# ── Model ────────────────────────────────────────────────────────────────────
# Two files, downloaded once from the kokoro-onnx "model-files" GitHub release:
#   https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/kokoro-v1.0.onnx
#   https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/voices-v1.0.bin
TTS_MODEL_PATH=~/robot_ws/models/kokoro/kokoro-v1.0.onnx
TTS_VOICES_PATH=~/robot_ws/models/kokoro/voices-v1.0.bin

# ONNX Runtime intra-op threads. 4 on the Orin, matching what the in-process
# gateway used, so TTS does not take the whole CPU from the ROS stack.
TTS_INTRA_OP_THREADS=4

# Load the ~310 MB session in a background thread at startup instead of on the
# first request. On by default here — unlike the in-process gateway, whose lazy
# load existed so a boot that never speaks never pays for it, this container
# exists only to speak, and a cold first utterance would otherwise burn ~3 s
# against a Temporal SPEAK step's start_to_close budget. /health reports
# `loading` until it is ready; requests that arrive first simply wait.
TTS_PRELOAD=true

TTS_DEFAULT_VOICE=af_heart

# ── Speaker ──────────────────────────────────────────────────────────────────
# Which ALSA device is the speaker is answered by udev, not here:
# syncai_sys_manager's 99-syncai-devices.rules keeps this symlink pointed at the
# speaker's pcm node whatever card number the kernel hands it this boot. Bind
# mount /dev/syncai into the container for it to resolve.
TTS_SPEAKER_PCM_LINK=/dev/syncai/speaker_pcm

# Fallback for hosts without those udev rules: the Jieli CD002 USB dongle by
# CARD= name rather than card number, which survives a replug. plughw rather
# than hw in both paths so ALSA resamples kokoro's 24 kHz to whatever the
# device supports.
TTS_FALLBACK_DEVICE=plughw:CARD=CD002AUDIO,DEV=0

# ── Playback queue ───────────────────────────────────────────────────────────
# How many utterances may wait behind the one playing. A 409 (code
# `queue_full`) past this, rather than an unbounded queue that answers 202 to
# everything and speaks it minutes later.
TTS_MAX_QUEUE=8

# Terminal jobs kept readable by GET /api/v1/speak/{id} after they finish.
# Their audio is dropped immediately; only the small record is retained. Records
# are evicted when a NEW utterance is accepted, oldest first — never as a job
# ends, so a caller polling the id it was handed never races the eviction.
TTS_JOB_HISTORY=64

# Seconds added to an utterance's own length before aplay is considered wedged
# and killed. The budget starts when playback starts, so a queued utterance is
# never charged for the one it waited on.
TTS_PLAYBACK_TIMEOUT_MARGIN=10.0

# ── Logging ──────────────────────────────────────────────────────────────────
# false renders structlog's colourised console output (dev, and the robot's
# byobu pane); true renders one JSON object per line for a log shipper.
TTS_LOG_JSON=false
